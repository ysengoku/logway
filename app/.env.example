# Copy to .env and fill in the values.
# On Vercel, set the same variables in the project settings.

# Google OAuth client (web application)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Random secret for encrypting the session cookie (e.g. `openssl rand -base64 32`)
SESSION_SECRET=

# Base URL used to build OAuth redirect URIs
APP_URL=http://localhost:3000

# Google API key for reading public share-link snapshots (restrict by HTTP referrer)
VITE_GOOGLE_API_KEY=

# Set to `true` to show only the maintenance page (read at build time, so redeploy after changing)
VITE_MAINTENANCE_MODE=
